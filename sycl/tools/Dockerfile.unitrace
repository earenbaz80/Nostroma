# nostroma-sycl-dev + Intel pti-gpu unitrace (per-kernel Level Zero profiling).
# It runs as root on purpose: it is a profiling tool, and the counters unitrace reads are the kind a plain account may not be able
# to open (not measured on an Arc yet: nothing here has been run rootless). It is never published - it is a tool used from a shell,
# over a 13 GB dev image - and the engine that serves Nostroma does not come from it (docs/INTEL.md).
# audit: root-ok — herramienta de perfilado sobre la imagen de desarrollo, no se publica; puede necesitar contadores que una cuenta común no abre
# Build:
#   docker build -t nostroma-sycl-dev:unitrace -f sycl/tools/Dockerfile.unitrace sycl/tools
# Base: the same image and the same packages as sycl/tools/Dockerfile, repeated here so this file pins its own
# digest (a locally built `nostroma-sycl-dev` tag has no digest to cite). Change the two files together.
ARG SYCL_BASE=ghcr.io/snailium/llama.cpp-sycl-intel-b70/llama-sycl-b70:stable@sha256:f040fa361d70e8d8b07c8cebdd0b59dc22062aa01b14c016c5fc94cd70a598ce
FROM ${SYCL_BASE}
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \r
      intel-oneapi-dpcpp-ct ninja-build unzip python3-pip python3-venv rsync \r
    && rm -rf /var/lib/apt/lists/*
RUN . /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1; \
    git clone --depth 1 https://github.com/intel/pti-gpu.git /opt/pti-gpu && \
    cd /opt/pti-gpu/tools/unitrace && mkdir build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release .. >/dev/null && make -j"$(nproc)" >/dev/null 2>&1 && ./unitrace --version
ENV PATH=/opt/pti-gpu/tools/unitrace/build:$PATH
